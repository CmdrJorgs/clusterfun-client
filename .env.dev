REACT_APP_DEVMODE=development
# REACT_APP_QUICKTEST = yes
#REACT_APP_USE_REAL_TELEMETRY=1
REACT_APP_SHOW_DEBUG_GAMES=1

# Lets `npm start` boot on machines running Tailscale, WSL, or a VPN.
#
# The `proxy` field in package.json makes CRA ENABLE webpack-dev-server's DNS-rebinding
# host check.  With the check on, allowedHosts is [urls.lanUrlForConfig], and CRA derives
# that from address.ip() while discarding anything outside RFC1918 (10.x / 172.16-31.x /
# 192.168.x).  A Tailscale interface enumerates first and reports a CGNAT 100.64.0.0/10
# address, so CRA throws it away and the dev server dies at startup with:
#     options.allowedHosts[0] should be a non-empty string
#
# Two things that look like fixes but are not:
#   - Setting HOST.  lanUrlForConfig is only assigned inside the `isUnspecifiedHost`
#     branch of prepareUrls(), so pinning HOST skips the assignment and fails identically.
#   - `tailscale down`.  That drops the tunnel but leaves the adapter Up on an APIPA
#     169.254.x address, which is also outside RFC1918, so nothing changes.
#
# Scope: this file is loaded only by `npm start` (the Test Lobby, which runs against a
# virtual in-memory server and makes no real API calls).  It never affects `npm run build`
# or production.
DANGEROUSLY_DISABLE_HOST_CHECK=true